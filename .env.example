# Variables de entorno de mto-field. Copiese a .env (no se versiona) para 'docker compose up'.
#
# La infraestructura (PostgreSQL, Keycloak, Jaeger) y el propio mto-maintenance viven en
# mto-platform; este fichero solo describe lo que la APLICACION lee. Los valores de aqui son los del
# entorno local y no valen para nada mas. TEST_DATABASE_URL / USERNAME / PASSWORD (los tests sin
# Docker) se dejan fuera a proposito: no son configuracion de la aplicacion.

# --- Perfil y puertos --------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# SPRING_PROFILES_DEFAULT=dev
# Dentro del contenedor: HTTP (Actuator) y gRPC.
SERVER_PORT=8080
SPRING_GRPC_SERVER_PORT=9090
# Publicados en el host. 8087 es el siguiente libre tras mto-notification (8086); 9094 para gRPC.
APP_PORT=8087
APP_GRPC_PORT=9094
APP_IMAGE_TAG=latest
APP_VERSION=0.0.1-SNAPSHOT

# --- Base de datos -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/mto_field
DATABASE_USERNAME=mto_field_user
DATABASE_PASSWORD=mto_field_password
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# --- Keycloak (resource server) ----------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
KEYCLOAK_CLIENT_ID=mto-field-api
KEYCLOAK_AUDIENCE=mto-field-api
KEYCLOAK_AUDIENCE_VALIDATION_ENABLED=true

# --- Keycloak (cuenta de servicio con la que se llama a mto-maintenance) -----------------------
KEYCLOAK_TOKEN_URI=http://auth.mto.local:8082/realms/mto/protocol/openid-connect/token
KEYCLOAK_SERVICE_CLIENT_ID=mto-field-svc
# El secreto de mto-field-svc; en local, el de keycloak/mto-field-dev.json.
KEYCLOAK_SERVICE_CLIENT_SECRET=

# --- mto-maintenance ---------------------------------------------------------------------------
# false hasta la fase 2: sin cliente REST, con true la aplicacion se niega a arrancar.
APP_MAINTENANCE_ENABLED=false
MTO_MAINTENANCE_URL=http://host.docker.internal:8083
APP_MAINTENANCE_SYNC_RETRY_ENABLED=true
# APP_MAINTENANCE_SYNC_RETRY_INTERVAL=PT1M
# APP_MAINTENANCE_CONNECT_TIMEOUT=2s
# APP_MAINTENANCE_READ_TIMEOUT=10s
# APP_MAINTENANCE_CB_SLIDING_WINDOW_SIZE=10
# APP_MAINTENANCE_CB_MINIMUM_NUMBER_OF_CALLS=5
# APP_MAINTENANCE_CB_FAILURE_RATE_THRESHOLD=50
# APP_MAINTENANCE_CB_WAIT_DURATION_IN_OPEN_STATE=30s
# APP_MAINTENANCE_CB_TIMEOUT=10s

# --- Servidor gRPC -----------------------------------------------------------------------------
# Keepalive de transporte (no es el latido de aplicacion). permit.time <= intervalo de ping del cliente.
# SPRING_GRPC_SERVER_KEEPALIVE_TIME=20s
# SPRING_GRPC_SERVER_KEEPALIVE_TIMEOUT=10s
# SPRING_GRPC_SERVER_KEEPALIVE_PERMIT_TIME=10s
# La reflexion (grpcurl) se apaga en prod.
SPRING_GRPC_SERVER_REFLECTION_ENABLED=false
# SPRING_GRPC_SERVER_SHUTDOWN_GRACE_PERIOD=30s

# --- Canal de campo ----------------------------------------------------------------------------
# APP_FIELD_OUTBOUND_QUEUE_CAPACITY=256
# APP_FIELD_WORK_QUEUE_CAPACITY=64
# APP_FIELD_BOARD_TICK=5s
# APP_FIELD_TOKEN_EXPIRY_ENABLED=false

# --- Actuator y trazas -------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MTO_TRACING_ENABLED=true
MTO_TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel.mto.local:4318/v1/traces

# --- Logs y JVM --------------------------------------------------------------------------------
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SQL=WARN
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport
# JPA_SHOW_SQL=false
# JPA_FORMAT_SQL=true
# SHUTDOWN_TIMEOUT=30s
